# Optional: without this key, official U.S. Treasury daily rates are used.
FRED_API_KEY=
# Optional: defaults to ./data. Use an absolute path if overriding.
MYBLOOMBERG_DATA_DIR=
# Optional: defaults to the existing Codex model, then CLI default.
MYBLOOMBERG_CODEX_MODEL=
# Optional: defaults to medium.
MYBLOOMBERG_CODEX_REASONING_EFFORT=medium
# Optional: alternate modern Codex CLI path; uses the project CLI otherwise.
MYBLOOMBERG_CODEX_BIN=
# Phase 5 (not used by Phase 1–2)
DISCORD_WEBHOOK_URL=
